<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-3">

    <!-- Listing Heading -->
    <div class="col-6 offset-3">
        <h3>Listing Details:</h3>
    </div>

    <!-- Listing Card -->
    <div class="card col-6 offset-3 listing-card show-card">

        <img
            src="<%= listing.image.url %>"
            class="card-img-top show-img"
            alt="listing_image"
        >

        <div class="card-body">

            <p class="card-text">
                Owned by :
                <i><%= listing.owner.username %></i>
            </p>

            <p class="card-text">
                <b><%= listing.title %></b>
                <br>

                <%= listing.description %>
                <br><br>

                &#8377;<%= listing.price.toLocaleString("en-IN") %>
                <br><br>

                <%= listing.location %>
                <br><br>

                <%= listing.country %>
                <br>
            </p>

        </div>
    </div>

    <!-- Edit & Delete Buttons -->
    <div class="col-6 offset-3 mt-3 d-flex gap-2">

        <a
            href="/listings/<%= listing._id %>/edit"
            class="btn btn-dark"
        >
            Edit
        </a>

        <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=DELETE"
        >
            <button class="btn btn-dark">
                Delete
            </button>
        </form>

    </div>

</div>


<!-- Reviews Section -->
<div class="row mt-4">

    <div class="col-6 offset-3">

        <hr>

        <h4>Leave Review</h4>

        <!-- Review Form -->
        <form
            action="/listings/<%= listing.id %>/reviews"
            method="POST"
            novalidate
            class="needs-validation"
        >

            <!-- Rating -->
            <div class="mb-3 mt-3">

                <label for="rating" class="form-label">
                    Rating
                </label>

                <input
                    type="range"
                    min="1"
                    max="5"
                    id="rating"
                    name="review[rating]"
                    class="form-range"
                >

            </div>


            <!-- Comment -->
            <div class="mb-3 mt-3">

                <label for="comment" class="form-label">
                    Comment
                </label>

                <textarea
                    name="review[comment]"
                    id="comment"
                    cols="30"
                    rows="5"
                    class="form-control"
                    required
                ></textarea>

                <div class="invalid-feedback">
                    Please submit feedback.
                </div>

            </div>


            <!-- Submit -->
            <button class="btn btn-outline-dark">
                Submit
            </button>

        </form>

        <hr>

        <!-- All Reviews -->
        

<% if(listing.reviews.length > 0) { %>
        <div class="row">
             <h4 class="mb-3">All Reviews</h4>

            <% for(review of listing.reviews) { %>

                <div class="card col-12 mb-3">

                    <div class="card-body">

                        <!-- Username -->
                        <h5 class="card-title">
                            @<%= review.author
                                ? review.author.username
                                : "Anonymous" %>
                        </h5>


                        <!-- Comment -->
                        <p class="card-text">
                            <%= review.comment %>
                        </p>


                        <!-- Star Rating -->
                        <div class="rating-stars">

                            <% for(let i = 1; i <= 5; i++) { %>

                                <% if(i <= review.rating) { %>

                                    <span class="star filled">★</span>

                                <% } else { %>

                                    <span class="star">☆</span>

                                <% } %>

                            <% } %>

                        </div>


                        <!-- Delete Review -->
                        <form
                            class="mt-3"
                            method="POST"
                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                        >

                            <button class="btn btn-sm btn-dark">
                                Delete
                            </button>

                        </form>

                    </div>

                </div>

            <% } %>

        </div>
        <% } %>


    </div>
         <div class="col-6 offset-3 mb-3">
            <h3>Where you'll be</h3>
            <div id="map"></div>

    </div>
   

</div>
<script>

    // Mapbox Token
    const mapToken = "<%= process.env.MAP_TOKEN %>";

    mapboxgl.accessToken = mapToken;


    // Listing ki location + country
    const listingLocation = "<%= listing.location %>, <%= listing.country %>";

    console.log("Listing Location:", listingLocation);


    // Map create
    const map = new mapboxgl.Map({

        container: "map",

        // Temporary/default center
        center: [78.9629, 20.5937],

        zoom: 5

    });


    // Mapbox Geocoding API
    fetch(
        `https://api.mapbox.com/search/geocode/v6/forward?q=${encodeURIComponent(listingLocation)}&access_token=${mapToken}`
    )

    .then(response => response.json())

    .then(data => {

        console.log("Geocoding Data:", data);


        // Check location found or not
        if (data.features && data.features.length > 0) {

            const coordinates = data.features[0].geometry.coordinates;

            console.log("Coordinates:", coordinates);


            // Map ko listing ki location par le jao
            map.setCenter(coordinates);

            map.setZoom(12);


            // Marker add karo
            new mapboxgl.Marker()
                .setLngLat(coordinates)
                .addTo(map);

        } else {

            console.log("Location not found!");

        }

    })

    .catch(error => {

        console.log("Geocoding Error:", error);

    });

</script>